OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
PORT=8787

# Optional: a fine-grained GitHub token with only the repositories/scopes you need.
# Never paste a token into the chat box.
GITHUB_TOKEN=

# Comma-separated HTTPS hosts the read-only browser tool may fetch.
BROWSER_ALLOWED_HOSTS=developer.mozilla.org,docs.github.com,github.com,wikipedia.org,khanacademy.org,arxiv.org

